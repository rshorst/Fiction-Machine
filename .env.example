# Copy this file to .env and fill in what you need. .env is never committed.
# You can also skip this: run_full.py asks for the Anthropic key the first time.

# Required: runs every agent. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: only for building your own face library with pull_faces.py.
# Get one at https://unsplash.com/developers. Use is subject to Unsplash's API terms.
UNSPLASH_ACCESS_KEY=

# Optional: where your vault, database, faces and logs live. Defaults to this folder.
UNSLOP_HOME=

# Optional: the agents' model. The machine was made on Opus; cheaper models run but write differently.
UNSLOP_MODEL=anthropic/claude-opus-4-7

# Optional: path to Chrome or Chromium for the story PDF. Found automatically if installed.
CHROME_PATH=

# CrewAI's and ChromaDB's anonymous usage telemetry is switched off by default
# (see config.py). Uncomment to switch it back on.
# CREWAI_DISABLE_TELEMETRY=false
# ANONYMIZED_TELEMETRY=True
